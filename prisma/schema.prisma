// SME Islamic Banking Platform — data model
//
// Development runs on SQLite so the platform can be evaluated with zero
// infrastructure. Production deployments target PostgreSQL (change the
// provider, map money columns to NUMERIC(20,2) and enums to native enums).
// Enumerations are stored as strings; the allowed values live in
// src/lib/constants.ts so they stay identical across providers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & organisation
// ---------------------------------------------------------------------------

/// One white-label bank. Every business row carries tenantId.
model Tenant {
  id              String   @id @default(cuid())
  code            String   @unique // short login code, e.g. IBP
  name            String // brand name shown in the UI
  legalName       String
  bankType        String // ISLAMIC | CONVENTIONAL_IBW
  primaryColor    String   @default("#0f5132")
  accentColor     String   @default("#c9a227")
  logoText        String   @default("IB")
  tagline         String   @default("")
  shariahBoardRef String   @default("")
  settings        String   @default("{}") // JSON: see TenantSettings in src/lib/tenant.ts
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  orgUnits      OrgUnit[]
  users         User[]
  customers     Customer[]
  cases         FinancingCase[]
  templates     Template[]
  auditEvents   AuditEvent[]
  files         StoredFile[]
  notifications Notification[]
}

/// Bank hierarchy: COUNTRY > REGION > UNIT > TEAM. `path` is the
/// materialised path of ids (e.g. "/c1/r1/u1/t1/") used for scoping.
model OrgUnit {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  type      String // COUNTRY | REGION | UNIT | TEAM
  code      String
  name      String
  parentId  String?
  parent    OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children  OrgUnit[] @relation("OrgTree")
  path      String
  users     User[]
  createdAt DateTime  @default(now())

  @@unique([tenantId, code])
}

model User {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  username          String
  fullName          String
  email             String    @default("")
  mobile            String    @default("")
  employeeId        String    @default("")
  passwordHash      String
  kind              String // BANK | CUSTOMER
  role              String // see ROLES in src/lib/rbac.ts
  orgUnitId         String?
  orgUnit           OrgUnit?  @relation(fields: [orgUnitId], references: [id])
  customerId        String?
  customer          Customer? @relation("CustomerUsers", fields: [customerId], references: [id])
  approvalLimit     Float? // overrides the matrix default for this officer
  status            String    @default("ACTIVE") // ACTIVE | LOCKED | DISABLED
  failedLogins      Int       @default(0)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())

  sessions      Session[]
  managedCases  FinancingCase[] @relation("CaseRM")
  rmCustomers   Customer[]      @relation("CustomerRM")
  notifications Notification[]

  @@unique([tenantId, username])
}

model Session {
  id           String    @id // sha256 of the cookie token
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tenantId     String
  mfaVerified  Boolean   @default(false)
  ip           String    @default("")
  userAgent    String    @default("")
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
}

model OtpChallenge {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  purpose     String // LOGIN | SIGN
  refId       String    @default("") // session id or document id
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Customers (SMEs)
// ---------------------------------------------------------------------------

model Customer {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  cif                String // core-banking customer number
  legalName          String
  tradeName          String    @default("")
  legalForm          String // SOLE_PROPRIETOR | PARTNERSHIP | PRIVATE_LIMITED | PUBLIC_LIMITED | AOP
  ntn                String    @default("")
  strn               String    @default("")
  registrationNo     String    @default("") // SECP / Registrar of Firms
  establishedOn      DateTime?
  sector             String
  businessActivity   String    @default("")
  address            String    @default("")
  city               String    @default("")
  annualTurnover     Float // PKR — drives SBP SME classification
  smeCategory        String // MICRO | SMALL | MEDIUM | NOT_SME
  isStartup          Boolean   @default(false)
  womenLed           Boolean   @default(false)
  riskCategory       String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  kycStatus          String    @default("PENDING") // PENDING | CLEARED | RETURNED
  kycClearedAt       DateTime?
  kycClearedById     String?
  kycRemarks         String    @default("")
  ecibCheckedAt      DateTime? // R-7
  ecibOverdue        Boolean   @default(false)
  ecibRemarks        String    @default("")
  relatedParty       Boolean   @default(false) // R-11
  otherBankExposure  Float     @default(0) // R-5, from e-CIB
  premisesLat        Float? // R-14 geo-tagged premises
  premisesLng        Float?
  rmId               String
  rm                 User      @relation("CustomerRM", fields: [rmId], references: [id])
  orgUnitId          String // owning team
  orgPath            String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  people    CustomerPerson[]
  users     User[]            @relation("CustomerUsers")
  cases     FinancingCase[]
  kycDocs   CustomerDocument[]

  @@unique([tenantId, cif])
}

/// Directors, partners, UBOs, guarantors and authorised signatories.
model CustomerPerson {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  fullName   String
  cnic       String
  role       String // PROPRIETOR | DIRECTOR | PARTNER | UBO | GUARANTOR | SIGNATORY
  sharePct   Float    @default(0)
  isPep      Boolean  @default(false)
  mobile     String   @default("")
  createdAt  DateTime @default(now())
}

model CustomerDocument {
  id           String     @id @default(cuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id])
  docType      String
  fileId       String
  file         StoredFile @relation(fields: [fileId], references: [id])
  status       String     @default("UPLOADED") // UPLOADED | VERIFIED | REJECTED
  verifiedById String?
  verifiedAt   DateTime?
  remarks      String     @default("")
  uploadedById String
  createdAt    DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// Financing cases
// ---------------------------------------------------------------------------

/// One immutable case file per financing request.
model FinancingCase {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  ref             String // SME-2026-00001
  cptmNo          String? // R-19 application acknowledgement serial
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  productCode     String
  purpose         String
  amount          Float // bank's financing amount, PKR
  tenorMonths     Int
  profitRate      Float // annual %, e.g. 6-month KIBOR + spread
  benchmark       String    @default("6M KIBOR")
  repayment       String    @default("MONTHLY") // MONTHLY | QUARTERLY | BULLET
  securityType    String    @default("SECURED") // SECURED | CLEAN
  collateral      String    @default("") // description of securities (R-13)
  liquidLien      Float     @default(0) // liquid assets under perfected lien (R-5)
  structure       String    @default("{}") // product-specific JSON
  ecibJustification String  @default("") // R-7 reasons where borrower has overdues
  stage           String    @default("DRAFT")
  classification  String    @default("REGULAR") // REGULAR | SUBSTANDARD | DOUBTFUL | LOSS
  daysPastDue     Int       @default(0)
  rmId            String
  rm              User      @relation("CaseRM", fields: [rmId], references: [id])
  orgUnitId       String
  orgPath         String
  submittedAt     DateTime?
  tatDueAt        DateTime?
  sanctionedAt    DateTime?
  offeredAt       DateTime?
  acceptedAt      DateTime?
  activatedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clearances  Clearance[]
  approvals   Approval[]
  documents   Document[]
  steps       ExecutionStep[]
  evidence    Evidence[]
  schedule    Installment[]
  comments    CaseComment[]

  @@unique([tenantId, ref])
}

/// Parallel review tracks: RCAD, CREDIT, TRADE, SHARIAH, LEGAL.
model Clearance {
  id          String        @id @default(cuid())
  caseId      String
  case        FinancingCase @relation(fields: [caseId], references: [id])
  track       String
  status      String        @default("PENDING") // PENDING | CLEARED | RETURNED
  checklist   String        @default("{}") // JSON map of item -> boolean
  riskRating  String        @default("")
  comments    String        @default("")
  decidedById String?
  decidedAt   DateTime?
  round       Int           @default(1)
  createdAt   DateTime      @default(now())

  @@unique([caseId, track])
}

/// Delegated-authority chain, evaluated in `level` order.
model Approval {
  id          String        @id @default(cuid())
  caseId      String
  case        FinancingCase @relation(fields: [caseId], references: [id])
  level       Int
  role        String
  action      String // RECOMMEND | APPROVE
  limit       Float?
  status      String        @default("PENDING") // PENDING | APPROVED | REJECTED | RETURNED
  decidedById String?
  decidedAt   DateTime?
  comments    String        @default("")
  round       Int           @default(1)
  createdAt   DateTime      @default(now())
}

model CaseComment {
  id        String        @id @default(cuid())
  caseId    String
  case      FinancingCase @relation(fields: [caseId], references: [id])
  authorId  String
  body      String
  internal  Boolean       @default(true) // hidden from customer users
  createdAt DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Templates, documents & signatures
// ---------------------------------------------------------------------------

/// Bank-configurable, version-controlled template. Only APPROVED versions
/// (Shariah + Legal sign-off) can be used to generate case documents.
model Template {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  code              String
  title             String
  version           Int
  body              String
  status            String    @default("DRAFT") // DRAFT | APPROVED | RETIRED
  shariahRef        String    @default("")
  shariahApprovedBy String?
  shariahApprovedAt DateTime?
  legalRef          String    @default("")
  legalApprovedBy   String?
  legalApprovedAt   DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  documents         Document[]

  @@unique([tenantId, code, version])
}

model Document {
  id          String        @id @default(cuid())
  tenantId    String
  caseId      String
  case        FinancingCase @relation(fields: [caseId], references: [id])
  templateId  String
  template    Template      @relation(fields: [templateId], references: [id])
  code        String
  title       String
  version     Int           @default(1)
  content     String // rendered text (placeholders resolved) — hashed & signed
  contentHash String
  signerPlan  String // JSON: SignerSlot[]
  status      String        @default("ISSUED") // ISSUED | EXECUTED | DECLINED | VOID
  stepKey     String?
  createdById String
  createdAt   DateTime      @default(now())
  executedAt  DateTime?
  signatures  Signature[]
}

/// Append-only (DB triggers block UPDATE/DELETE).
model Signature {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  slot        Int
  party       String // CUSTOMER | GUARANTOR | BANK
  capacity    String // e.g. "Customer — Authorised Signatory"
  signerId    String
  signerName  String // name as typed by the signer
  signerRole  String
  method      String // OTP_ESIGN | ...
  decision    String // SIGNED | DECLINED
  reason      String   @default("")
  docHash     String
  seal        String // HMAC seal binding signer, slot, time and hash
  ip          String   @default("")
  userAgent   String   @default("")
  lat         Float?
  lng         Float?
  accuracy    Float?
  signedAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Execution steps, evidence & schedule
// ---------------------------------------------------------------------------

model ExecutionStep {
  id            String        @id @default(cuid())
  caseId        String
  case          FinancingCase @relation(fields: [caseId], references: [id])
  key           String
  seq           Int
  title         String
  kind          String // SIGN | EVIDENCE | ACTION | CHECK
  status        String        @default("LOCKED") // LOCKED | READY | DONE
  config        String        @default("{}") // JSON: StepSpec
  completedById String?
  completedAt   DateTime?
  outcome       String        @default("{}") // JSON: refs, amounts, remarks

  @@unique([caseId, key])
}

model Evidence {
  id              String        @id @default(cuid())
  tenantId        String
  caseId          String
  case            FinancingCase @relation(fields: [caseId], references: [id])
  stepKey         String?
  category        String // POSSESSION | DELIVERY | INSPECTION | MILESTONE | SITE_VISIT | INVOICE | TITLE | TAKAFUL | VALUATION | OTHER
  description     String        @default("")
  assetRef        String        @default("")
  fileId          String
  file            StoredFile    @relation("EvidenceOriginal", fields: [fileId], references: [id])
  stampedFileId   String?
  stampedFile     StoredFile?   @relation("EvidenceStamped", fields: [stampedFileId], references: [id])
  lat             Float?
  lng             Float?
  accuracy        Float?
  locationNote    String        @default("")
  serverTime      DateTime      @default(now())
  clientTime      String        @default("")
  device          String        @default("{}") // JSON
  ip              String        @default("")
  capturedById    String
  status          String        @default("SUBMITTED") // SUBMITTED | VERIFIED | REJECTED
  verifiedById    String?
  verifiedAt      DateTime?
  verifyRemarks   String        @default("")
}

model StoredFile {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  sha256       String // hash of the plaintext
  size         Int
  mimeType     String
  originalName String
  storageKey   String // path under STORAGE_DIR
  iv           String
  authTag      String
  uploadedById String
  createdAt    DateTime @default(now())

  evidence         Evidence[]         @relation("EvidenceOriginal")
  stampedEvidence  Evidence[]         @relation("EvidenceStamped")
  customerDocs     CustomerDocument[]
}

model Installment {
  id          String        @id @default(cuid())
  caseId      String
  case        FinancingCase @relation(fields: [caseId], references: [id])
  seq         Int
  dueDate     DateTime
  principal   Float // cost / unit price / capital component
  profit      Float // profit / rental component
  total       Float
  units       Float         @default(0) // Diminishing Musharakah units purchased
  bankShare   Float         @default(0) // bank's remaining ownership after this instalment
  paidAmount  Float         @default(0)
  paidAt      DateTime?
  status      String        @default("DUE") // DUE | PAID | OVERDUE
}

// ---------------------------------------------------------------------------
// Audit & notifications
// ---------------------------------------------------------------------------

/// Tamper-evident, hash-chained, append-only audit trail.
/// hash = SHA-256(prevHash || canonical(event)). DB triggers block UPDATE/DELETE.
model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  seq         Int
  eventType   String
  action      String // CREATE | VIEW | UPDATE | APPROVE | SIGN | UPLOAD | DOWNLOAD | LOGIN | ...
  summary     String
  caseId      String?
  customerId  String?
  entityType  String   @default("")
  entityId    String   @default("")
  actorId     String?
  actorName   String   @default("system")
  actorRole   String   @default("SYSTEM")
  before      String   @default("")
  after       String   @default("")
  docHash     String   @default("")
  ip          String   @default("")
  userAgent   String   @default("")
  lat         Float?
  lng         Float?
  accuracy    Float?
  occurredAt  DateTime @default(now())
  prevHash    String
  hash        String

  @@unique([tenantId, seq])
  @@index([tenantId, caseId])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String    @default("")
  link      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())
}
